# Copy this file to `.env` and fill in your real keys.
#   cp .env.demo .env

# Nebius Token Factory — used for EMBEDDINGS (Qwen/Qwen3-Embedding-8B, 4096-dim).
# This is the assignment's required Nebius model call.
NEBIUS_API_KEY=...

# Anthropic — used for GENERATION (claude-opus-4-8).
ANTHROPIC_API_KEY=sk-ant-...

# Pinecone — vector store for the RAG index.
PINECONE_API_KEY=...

# Name of your Pinecone index (created automatically if it does not exist).
# Must be 4096-dim vectors with cosine similarity to match Qwen3-Embedding-8B.
PINECONE_INDEX_NAME=hr-policies-rag
